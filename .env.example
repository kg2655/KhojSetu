# Optional process environment settings; .env is not automatically loaded.
# The default local setup needs no API key or account.
# PowerShell example: $env:QDRANT_URL = 'http://127.0.0.1:6333'
QDRANT_URL=http://127.0.0.1:6333
KHOJ_SYNC_URL=http://127.0.0.1:8010
KHOJ_DEVICE=FIELD-07
# QDRANT_API_KEY=         # Only for an authenticated external Qdrant server
# KHOJ_SYNC_TOKEN=        # Set the same token on field service and gateway
# KHOJ_DATA=.data/field-07
# KHOJ_CLOUD_DATA=.data/cloud
