        <mxCell id="boundary" value="Local search needs no network. Exchange needs a reachable gateway. Current demo server: local Docker.&#10;Photos are attachments, not image embeddings. Two-laptop LAN deployment still needs setup/rehearsal." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#f3f0e6;strokeColor=#bac5b0;fontColor=#283c32;fontSize=21;fontFamily=Helvetica;align=left;spacing=16;">
