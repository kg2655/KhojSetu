  <diagram name="02 Reliability and resource rules">
    <mxGraphModel grid="1" gridSize="10" page="1" pageWidth="1600" pageHeight="1020" background="#f3f0e6">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="rule0" value="01 / PRIVATE BY DEFAULT&#10;&#10;Approval, sensitivity, visibility and priority decide uploads. Photo sharing requires explicit approval." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e6ebdf;strokeColor=#bac5b0;fontColor=#283c32;fontSize=23;fontFamily=Helvetica;align=left;spacing=16;">
          <mxGeometry as="geometry" x="50" y="60" width="730" height="235" />
        </mxCell>
        <mxCell id="rule1" value="02 / DURABLE EXCHANGE&#10;&#10;SQLite outbox records an event before transmission. Receipts reconcile uncertain acknowledgements; newer edits remain pending." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#eee3d5;strokeColor=#bac5b0;fontColor=#283c32;fontSize=23;fontFamily=Helvetica;align=left;spacing=16;">
          <mxGeometry as="geometry" x="820" y="60" width="730" height="235" />
        </mxCell>
        <mxCell id="rule2" value="03 / BOUNDED TRANSFERS&#10;&#10;Up to 20 normal record uploads and 20 downloaded changes per cycle. Configurable body-byte budgets; photo chunks up to 64 KiB." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e6ebdf;strokeColor=#bac5b0;fontColor=#283c32;fontSize=23;fontFamily=Helvetica;align=left;spacing=16;">
          <mxGeometry as="geometry" x="50" y="330" width="730" height="235" />
        </mxCell>
        <mxCell id="rule3" value="04 / RECOVER AND REVIEW&#10;&#10;Version mismatch creates a reviewable conflict. Background retry backs off. Shared withdrawal is distinct from erasing audit history." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#eee3d5;strokeColor=#bac5b0;fontColor=#283c32;fontSize=23;fontFamily=Helvetica;align=left;spacing=16;">
          <mxGeometry as="geometry" x="820" y="330" width="730" height="235" />
        </mxCell>
        <mxCell id="rule4" value="05 / SMALL LOCAL MEMORY&#10;&#10;Selective site/material downloads, pin/remove/restore references, admission budgets and protected unused-photo cleanup." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e6ebdf;strokeColor=#bac5b0;fontColor=#283c32;fontSize=23;fontFamily=Helvetica;align=left;spacing=16;">
          <mxGeometry as="geometry" x="50" y="600" width="730" height="235" />
        </mxCell>
        <mxCell id="rule5" value="06 / DATA AND LIMITS&#10;&#10;40 synthetic seed records; optional 8 sourced museum references. Pack limit: 100 text records / 1 MiB. Model and index overhead still apply." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#eee3d5;strokeColor=#bac5b0;fontColor=#283c32;fontSize=23;fontFamily=Helvetica;align=left;spacing=16;">
          <mxGeometry as="geometry" x="820" y="600" width="730" height="235" />
        </mxCell>
        <mxCell id="limits" value="Not claimed: image recognition, generative archaeological expertise, native phone execution, public cloud deployment or production multi-team access." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#f3f0e6;strokeColor=#bac5b0;fontColor=#283c32;fontSize=22;fontFamily=Helvetica;align=left;spacing=16;">
          <mxGeometry as="geometry" x="50" y="875" width="1500" height="95" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>